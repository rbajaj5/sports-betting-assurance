{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betguard.example/schemas/v1/formation_evidence.schema.json",
  "title": "BetGuard formation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "game_id", "clip_source_id", "source_uri", "rights_basis", "clip_sha256", "clip_start_timestamp", "clip_end_timestamp", "calibration_method", "calibration_rmse_feet", "identity_tracking_method", "projected_lineup_coverage", "possession_count", "usable_frame_count", "player_ids", "coordinates", "derived_features"],
  "properties": {
    "schema_version": {"const": "betguard-historical-v1"},
    "game_id": {"type": "string", "minLength": 2},
    "clip_source_id": {"type": "string", "minLength": 2},
    "source_uri": {"type": "string", "minLength": 1},
    "rights_basis": {"enum": ["user_supplied", "official_public", "licensed", "synthetic", "redacted"]},
    "clip_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
    "clip_start_timestamp": {"type": "string", "format": "date-time"},
    "clip_end_timestamp": {"type": "string", "format": "date-time"},
    "calibration_method": {"type": "string", "minLength": 1},
    "calibration_rmse_feet": {"type": "number", "minimum": 0},
    "identity_tracking_method": {"type": "string", "minLength": 1},
    "projected_lineup_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "possession_count": {"type": "integer", "minimum": 0},
    "usable_frame_count": {"type": "integer", "minimum": 0},
    "player_ids": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
    "coordinates": {"type": "array", "items": {"type": "object", "required": ["timestamp_seconds", "player_id", "x_feet", "y_feet"], "properties": {"timestamp_seconds": {"type": "number"}, "player_id": {"type": "string"}, "x_feet": {"type": "number"}, "y_feet": {"type": "number"}}}},
    "derived_features": {"type": "object", "additionalProperties": {"type": "number"}}
  }
}
