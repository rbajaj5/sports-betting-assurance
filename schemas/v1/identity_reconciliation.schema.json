{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betguard.example/schemas/v1/identity_reconciliation.schema.json",
  "title": "BetGuard stable-ID reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entity_type", "canonical_id", "source_system", "source_id", "display_name", "effective_start", "effective_end", "evidence_url"],
  "properties": {
    "schema_version": {"const": "betguard-historical-v1"},
    "entity_type": {"enum": ["game", "team", "player", "operator"]},
    "canonical_id": {"type": "string", "minLength": 2},
    "source_system": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 2},
    "display_name": {"type": "string", "minLength": 1},
    "effective_start": {"type": "string", "format": "date-time"},
    "effective_end": {"type": ["string", "null"], "format": "date-time"},
    "evidence_url": {"type": "string", "format": "uri"}
  }
}
